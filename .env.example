# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development
TIMEZONE=America/New_York
LOG_LEVEL=INFO

# --- Dashboard auth (single user) ---
DASHBOARD_USERNAME=me
# Generate with: .venv/bin/python -m scripts.hash_password
DASHBOARD_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Database (Neon or Supabase Postgres with pgvector) ---
# Paste the Neon/Supabase connection string as-is (postgresql://...). Use a direct or
# session-mode connection, not a transaction-mode pooler (the tracker uses advisory locks).
DATABASE_URL=

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_CLASSIFIER_MODEL=claude-opus-5-5
CLAUDE_WRITER_MODEL=claude-opus-5-5

# --- Gmail OAuth (files live in project root, git-ignored) ---
GMAIL_CREDENTIALS_FILE=credentials.json
# Tracker token: gmail.readonly only
GMAIL_READONLY_TOKEN_FILE=token.json
# Cold-mail sender token: gmail.send only
GMAIL_SEND_TOKEN_FILE=token_send.json
# Local login port. For a "Web application" OAuth client, register
# http://localhost:8080/ (trailing slash included) as an authorized redirect URI.
GMAIL_OAUTH_PORT=8080
# Encrypts Gmail tokens stored in the database. Created automatically on first run locally;
# copy the same value to your server when you deploy. Losing it means reconnecting inboxes.
TOKEN_ENCRYPTION_KEY=
# Where the app is reachable. For "Connect Gmail", add {PUBLIC_BASE_URL}/oauth/google/callback
# as an Authorized redirect URI on your Google OAuth client.
PUBLIC_BASE_URL=http://localhost:8000
# Servers only: paste the whole credentials.json content here instead of uploading the file
GOOGLE_OAUTH_CLIENT_JSON=

# --- Tracker ---
POLL_INTERVAL_MINUTES=60
# First run only: how far back to look before switching to incremental historyId sync
INITIAL_BACKFILL_DAYS=30
CLASSIFIER_CONFIDENCE_THRESHOLD=0.75
DIGEST_HOUR=20
# Run the hourly tracker inside the web app process
SCHEDULER_ENABLED=true
# Local embedding model for the similarity matching tier (~70 MB download on first use)
EMBEDDINGS_ENABLED=true

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
# Optional (WhatsApp via Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=

# --- Cold mailing ---
OUTREACH_DAILY_CAP=30
OUTREACH_MIN_GAP_SECONDS=60
OUTREACH_MAX_GAP_SECONDS=180
OUTREACH_DEDUPE_DAYS=30
FOLLOWUP_BUSINESS_DAYS=5
